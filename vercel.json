{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "node --version",
  "buildCommand": "node build.mjs",
  "outputDirectory": "dist",
  "functions": {"api/*.js": {"maxDuration": 60}},
  "headers": [{"source": "/(.*)", "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}, {"key": "Referrer-Policy", "value": "no-referrer"}]}, {"source": "/api/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store"}]}]
}
